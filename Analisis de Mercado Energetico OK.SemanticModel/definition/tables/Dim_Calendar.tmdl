	/// Número de día de la semana (1=Lunes, 7=Domingo) para ordenar Day Name
	column 'Day Number' = WEEKDAY(Dim_Calendar[Date], 2)
		dataType: int64
		formatString: 0
		lineageTag: 3cd8c95c-296a-44da-8d66-b3e2a06c74ba
		summarizeBy: none

	partition Dim_Calendar = calculated
		mode: import
		source =
				
				VAR MinDate = MIN ( MIN ( Fact_Precios[Fecha] ), MIN ( Fact_Demanda[Fecha] ) )
				VAR MaxDate = MAX ( MAX ( Fact_Precios[Fecha] ), MAX ( Fact_Demanda[Fecha] ) )
				RETURN
				ADDCOLUMNS (
				    CALENDAR ( MinDate, MaxDate ),
				
				    // Año
				    "Year", YEAR ( [Date] ),
				
				    // Mes
				    "Month Number", MONTH ( [Date] ),
				    "Month Short Name", FORMAT ( [Date], "MMM" ),
				    "Month Full Name", FORMAT ( [Date], "MMMM" ),
				
				    // Trimestre
				    "Trimestre Number", QUARTER ( [Date] ),
				    "Trimestre Name", "T" & QUARTER ( [Date] ),
				    "Trimestre & Year", "T" & QUARTER ( [Date] ) & " " & YEAR ( [Date] ),
				
				    // Semestre
				    "Semester Number",
				        VAR m = MONTH ( [Date] )
				        RETURN IF ( m <= 6, 1, 2 ),
				    "Semester Name",
				        VAR m = MONTH ( [Date] )
				        RETURN "S" & IF ( m <= 6, 1, 2 ),
				    "Semester & Year",
				        VAR m = MONTH ( [Date] )
				        RETURN "S" & IF ( m <= 6, 1, 2 ) & " " & YEAR ( [Date] ),
				
				    // Semana
				    "Week Number", WEEKNUM ( [Date], 2 ),
				    "Week Name", "W" & FORMAT ( WEEKNUM ( [Date], 2 ), "00" ),
				
				    // Día
				    "Day", DAY ( [Date] ),
				    "Day Name", FORMAT ( [Date], "dddd" ),
				
				    // Combinaciones útiles
				    "Month & Year", FORMAT ( [Date], "MMM yyyy" ),
				    "Quarter & Year Short", FORMAT ( [Date], "\QQ yyyy" ),
				
				    // Claves de orden
				    "YearMonth Key", YEAR ( [Date] ) * 100 + MONTH ( [Date] ),
				    "YearWeek Key", YEAR ( [Date] ) * 100 + WEEKNUM ( [Date], 2 ),
				    "YearQuarter Key", YEAR ( [Date] ) * 10 + QUARTER ( [Date] ),
				    "YearSemester Key", YEAR ( [Date] ) * 10 + IF ( MONTH ( [Date] ) <= 6, 1, 2 )
				)

	annotation PBI_Id = ef3d74f09e3844209c936d7ee372cdc8

