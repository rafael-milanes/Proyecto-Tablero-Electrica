/// Tabla contenedora de todas las medidas DAX del modelo
table _Medidas
	isHidden
	lineageTag: 9eb9dd89-d5ec-4922-b775-62ec81079b8f

	/// Suma total de demanda en GWh
	measure 'Total Demanda GWh' = SUM(Fact_Demanda[Demanda_GWh])
		formatString: #,##0.0
		displayFolder: 01. KPIs Ejecutivos
		lineageTag: 979ab5c2-21a4-4985-8569-b715c17916cc

	/// Demanda total del mercado No Regulado
	measure 'Total Demanda No Regulado' = CALCULATE(SUM(Fact_Demanda[Demanda_GWh]), Fact_Demanda[Tipo_Mercado] = "No Regulado")
		formatString: #,##0.0
		displayFolder: 01. KPIs Ejecutivos
		lineageTag: d975863d-0ddf-4e80-9c09-86d28e1ea40b

	/// Demanda total del mercado Regulado
	measure 'Total Demanda Regulado' = CALCULATE(SUM(Fact_Demanda[Demanda_GWh]), Fact_Demanda[Tipo_Mercado] = "Regulado")
		formatString: #,##0.0
		displayFolder: 01. KPIs Ejecutivos
		lineageTag: 4941effd-87e0-41f1-add3-d8253c164043

	/// Porcentaje de demanda Regulado sobre el total
	measure '% Regulado' = DIVIDE([Total Demanda Regulado], [Total Demanda GWh], 0)
		formatString: 0.0%
		displayFolder: 01. KPIs Ejecutivos
		lineageTag: 3ae1137c-e53b-4ea6-808e-0b22a9c65405

	/// Número de departamentos únicos
	measure 'Conteo Departamentos' = DISTINCTCOUNT(Fact_Demanda[Departamento])
		formatString: #,##0
		displayFolder: 01. KPIs Ejecutivos
		lineageTag: 456a57c3-3546-41b3-80b1-6f08bce90f42

	/// Promedio diario de demanda en GWh
	measure 'Promedio Diario Demanda GWh' =
			AVERAGEX(
			    VALUES(Fact_Demanda[Fecha]),
			    CALCULATE(SUM(Fact_Demanda[Demanda_GWh]))
			)
		formatString: #,##0.0
		displayFolder: 02. Análisis de Demanda
		lineageTag: a4d333f0-512e-4b4a-bfeb-1593b05bcf9f

	/// Promedio diario de demanda No Regulado
	measure 'Promedio Diario NR' =
			AVERAGEX(
			    VALUES(Fact_Demanda[Fecha]),
			    CALCULATE(SUM(Fact_Demanda[Demanda_GWh]), Fact_Demanda[Tipo_Mercado] = "No Regulado")
			)
		formatString: #,##0.0
		displayFolder: 02. Análisis de Demanda
		lineageTag: 24659615-8709-461e-b4c9-ae85c5491af9

	/// Promedio diario de demanda Regulado
	measure 'Promedio Diario RG' =
			AVERAGEX(
			    VALUES(Fact_Demanda[Fecha]),
			    CALCULATE(SUM(Fact_Demanda[Demanda_GWh]), Fact_Demanda[Tipo_Mercado] = "Regulado")
			)
		formatString: #,##0.0
		displayFolder: 02. Análisis de Demanda
		lineageTag: d25d2229-8388-4853-b329-2cec75adfb52

	/// Mes con mayor demanda total
	measure 'Demanda Máxima Mensual' =
			MAXX(
			    SUMMARIZE(Fact_Demanda, Dim_Calendar[Month & Year]),
			    [Total Demanda GWh]
			)
		formatString: #,##0.0
		displayFolder: 02. Análisis de Demanda
		lineageTag: ed8e1c58-b147-4c3a-a07a-ec81f34c95b4

	/// Mes con menor demanda total
	measure 'Demanda Mínima Mensual' =
			MINX(
			    SUMMARIZE(Fact_Demanda, Dim_Calendar[Month & Year]),
			    [Total Demanda GWh]
			)
		formatString: #,##0.0
		displayFolder: 02. Análisis de Demanda
		lineageTag: 1386b623-d5ca-469c-a669-a979c1d6d969

	/// % de caída de demanda los domingos vs días hábiles
	measure 'Variación Domingo vs Semana' = ```
			VAR _PromedioSemana = 
			    AVERAGEX(
			        FILTER(VALUES(Fact_Demanda[Fecha]), WEEKDAY(Fact_Demanda[Fecha], 2) <= 5),
			        CALCULATE(SUM(Fact_Demanda[Demanda_GWh]))
			    )
			VAR _PromedioDomingo = 
			    AVERAGEX(
			        FILTER(VALUES(Fact_Demanda[Fecha]), WEEKDAY(Fact_Demanda[Fecha], 2) = 7),
			        CALCULATE(SUM(Fact_Demanda[Demanda_GWh]))
			    )
			RETURN
			    DIVIDE(_PromedioDomingo - _PromedioSemana, _PromedioSemana, 0)
			```
		formatString: 0.0%
		displayFolder: 02. Análisis de Demanda
		lineageTag: 1d032f50-fe95-42e8-ade5-d704b805d5fb

	/// % de participación del departamento en el total nacional
	measure 'Participación Departamento' =
			DIVIDE(
			    [Total Demanda GWh],
			    CALCULATE([Total Demanda GWh], ALL(Fact_Demanda[Departamento])),
			    0
			)
		formatString: 0.0%
		displayFolder: 02. Análisis de Demanda
		lineageTag: 7863c306-dedc-4d9d-960a-81da9d0edb08

	/// Ranking del departamento por demanda total (1=mayor)
	measure 'Ranking Departamento Demanda' =
			IF(
			    HASONEVALUE(Fact_Demanda[Departamento]),
			    RANKX(
			        ALL(Fact_Demanda[Departamento]),
			        [Total Demanda GWh],,DESC,Dense
			    )
			)
		formatString: #,##0
		displayFolder: 02. Análisis de Demanda
		lineageTag: d9893ad7-edb0-4d5e-8bca-732451dbac59

	/// Precio promedio en COP/kWh
	measure 'Precio Promedio COP/kWh' = AVERAGE(Fact_Precios[Precio_COP_kWh])
		formatString: $#,##0
		displayFolder: 03. Análisis de Precios
		lineageTag: 80f18f8a-038b-4f4b-9d33-c06a30d34b2b

	/// Precio máximo registrado
	measure 'Precio Máximo' = MAX(Fact_Precios[Precio_COP_kWh])
		formatString: $#,##0
		displayFolder: 03. Análisis de Precios
		lineageTag: e73de601-7a32-4039-b92b-b677788f28c0

	/// Precio mínimo registrado
	measure 'Precio Mínimo' = MIN(Fact_Precios[Precio_COP_kWh])
		formatString: $#,##0
		displayFolder: 03. Análisis de Precios
		lineageTag: 003bea61-e298-442b-9d8a-e279152e0198

	/// Diferencia entre precio máximo y mínimo (volatilidad)
	measure 'Rango de Precio' = [Precio Máximo] - [Precio Mínimo]
		formatString: $#,##0
		displayFolder: 03. Análisis de Precios
		lineageTag: c19b4528-aa4b-4e9a-b13d-8d5f4a3c0d5f

	/// Precio promedio filtrado a 2024
	measure 'Precio Promedio' =
			CALCULATE(
			    AVERAGE(Fact_Precios[Precio_COP_kWh])
			)
		formatString: $#,##0
		displayFolder: 03. Análisis de Precios
		lineageTag: 902b8394-b03d-44d7-a46e-42fb615831b3

	/// Precio máximo en 2024
	measure 'Precio Max 2024' =
			CALCULATE(
			    MAX((Fact_Precios[Precio_COP_kWh])),
			    Dim_Calendar[Year] = 2024
			)
		formatString: $#,##0
		displayFolder: 03. Análisis de Precios
		lineageTag: 6cce2bcb-2aa8-45d1-bd02-68041adf5125

	/// Precio mínimo en 2024
	measure 'Precio Min 2024' =
			CALCULATE(
			    MIN(Fact_Precios[Precio_COP_kWh]),
			    Dim_Calendar[Year] = 2024
			)
		formatString: $#,##0
		displayFolder: 03. Análisis de Precios
		lineageTag: 45a6c922-8e09-4a71-914b-9ebd3521df6e

	/// Ranking del OR por precio (1=más caro)
	measure 'Ranking OR Precio' =
			IF(
			    HASONEVALUE(Fact_Precios[Operador_Regional]),
			    RANKX(
			        ALL(Fact_Precios[Operador_Regional]),
			        [Precio Promedio],,DESC,Dense
			    )
			)
		formatString: #,##0
		displayFolder: 03. Análisis de Precios
		lineageTag: 793f7f5a-bf31-4b67-9312-cd6ebd2806be

	/// % de diferencia del OR actual vs Antioquia (el más barato)
	measure 'Diferencial vs Antioquia' = ```
			VAR _PrecioActual = [Precio Promedio]
			VAR _PrecioAntioquia = 
			    CALCULATE(
			        AVERAGE(Fact_Precios[Precio_COP_kWh]),
			        Fact_Precios[Operador_Regional] = "antioquia",
			        Dim_Calendar[Year] = 2024
			    )
			RETURN
			    DIVIDE(_PrecioActual - _PrecioAntioquia, _PrecioAntioquia, 0)
			```
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 03. Análisis de Precios
		lineageTag: efdc3a20-fb53-461e-8049-dfa42ddfe44d

	/// % variación del precio promedio 2024 vs agosto 2022 (inicio de serie)
	measure 'Variación Precio vs Inicio' = ```
			VAR _PrecioActual = [Precio Promedio]
			VAR _PrecioInicio = 
			    CALCULATE(
			        AVERAGE(Fact_Precios[Precio_COP_kWh]),
			        Dim_Calendar[Year] = 2022,
			        Dim_Calendar[Month Number] = 8
			    )
			RETURN
			    DIVIDE(_PrecioActual - _PrecioInicio, _PrecioInicio, 0)
			```
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 03. Análisis de Precios
		lineageTag: 116bb6e7-fc85-445e-ae85-a2959976d62d

	/// % de demanda concentrado en los 5 departamentos líderes
	measure 'Top 5 Concentración %' = ```
			VAR _Top5 = 
			    TOPN(5, ALL(Fact_Demanda[Departamento]), [Total Demanda GWh], DESC)
			VAR _DemandaTop5 = 
			    CALCULATE([Total Demanda GWh], KEEPFILTERS(_Top5))
			VAR _DemandaTotal = 
			    CALCULATE([Total Demanda GWh], ALL(Fact_Demanda[Departamento]))
			RETURN
			    DIVIDE(_DemandaTop5, _DemandaTotal, 0)
			```
		formatString: 0.0%
		displayFolder: 04. Estrategia y Oportunidades
		lineageTag: ebf25260-4bf9-4cf8-ad9c-ca9c57944fb2

	/// Demanda Regulada en Bogotá D.C. — potencial de migración
	measure 'Demanda Regulado Bogotá' =
			CALCULATE(
			    SUM(Fact_Demanda[Demanda_GWh]),
			    Fact_Demanda[Departamento] = "BOGOTÁ. D.C.",
			    Fact_Demanda[Tipo_Mercado] = "Regulado"
			)
		formatString: #,##0.0
		displayFolder: 04. Estrategia y Oportunidades
		lineageTag: 536a5ba3-219d-4bd6-95da-36e2fae74024

	/// % de demanda en Bogotá que es Regulada (potencialmente migrable)
	measure 'Potencial Migración Bogotá %' = ```
			VAR _RegBog = 
			    CALCULATE(
			        SUM(Fact_Demanda[Demanda_GWh]),
			        Fact_Demanda[Departamento] = "BOGOTÁ. D.C.",
			        Fact_Demanda[Tipo_Mercado] = "Regulado"
			    )
			VAR _TotalBog = 
			    CALCULATE(
			        SUM(Fact_Demanda[Demanda_GWh]),
			        Fact_Demanda[Departamento] = "BOGOTÁ. D.C."
			    )
			RETURN
			    DIVIDE(_RegBog, _TotalBog, 0)
			```
		formatString: 0.0%
		displayFolder: 04. Estrategia y Oportunidades
		lineageTag: 17fb4ba1-075c-40cf-bf2e-6c7eebf5757e

	/// Diferencial absoluto en COP/kWh entre Bogotá y Antioquia
	measure 'Diferencial Bogotá vs Antioquia $' = ```
			VAR _Bog = 
			    CALCULATE(
			        AVERAGE(Fact_Precios[Precio_COP_kWh]),
			        Fact_Precios[Operador_Regional] = "bogota_cundinamarca",
			        Dim_Calendar[Year] = 2024
			    )
			VAR _Ant = 
			    CALCULATE(
			        AVERAGE(Fact_Precios[Precio_COP_kWh]),
			        Fact_Precios[Operador_Regional] = "antioquia",
			        Dim_Calendar[Year] = 2024
			    )
			RETURN
			    _Bog - _Ant
			```
		formatString: $#,##0
		displayFolder: 04. Estrategia y Oportunidades
		lineageTag: 6903d297-373a-44f6-b9ae-b9d5aa84f316

	/// % que Bogotá es más caro que Antioquia
	measure 'Diferencial Bogotá vs Antioquia %' = ```
			VAR _Bog = 
			    CALCULATE(
			        AVERAGE(Fact_Precios[Precio_COP_kWh]),
			        Fact_Precios[Operador_Regional] = "bogota_cundinamarca",
			        Dim_Calendar[Year] = 2024
			    )
			VAR _Ant = 
			    CALCULATE(
			        AVERAGE(Fact_Precios[Precio_COP_kWh]),
			        Fact_Precios[Operador_Regional] = "antioquia",
			        Dim_Calendar[Year] = 2024
			    )
			RETURN
			    DIVIDE(_Bog - _Ant, _Ant, 0)
			```
		formatString: 0.0%
		displayFolder: 04. Estrategia y Oportunidades
		lineageTag: 14e9181a-7b29-4bd9-94b1-3299c657ec3f

	/// Clasificación cualitativa del departamento según su % No Regulado
	measure 'Clasificación NR Departamento' =
			VAR _Pnr = [% No Regulado]
			RETURN
			    SWITCH(
			        TRUE(),
			        _Pnr >= 0.95, "★ Alta concentración industrial",
			        _Pnr >= 0.85, "● Mercado maduro",
			        _Pnr >= 0.70, "◔ Oportunidad de migración",
			        "○ Predominio regulado"
			    )
		displayFolder: 04. Estrategia y Oportunidades
		lineageTag: 00b20814-b9ef-4fa1-a1ed-6e4f5b713fec

	/// Clasificación estratégica del mercado por demanda y composición
	measure 'Tier Mercado' =
			VAR _Demanda = [Total Demanda GWh]
			VAR _Pnr = [% No Regulado]
			RETURN
			    SWITCH(
			        TRUE(),
			        _Demanda >= 2500 && _Pnr >= 0.85, "Tier 1 - Prioritario",
			        _Demanda >= 1500 || (_Demanda >= 500 && _Pnr >= 0.90), "Tier 2 - Crecimiento",
			        "Tier 3 - Monitoreo"
			    )
		displayFolder: 04. Estrategia y Oportunidades
		lineageTag: cc5815b5-8c5d-4dfb-ab88-6d60ea8375c8

	/// Precio promedio de Bogotá-Cundinamarca en 2024
	measure 'Precio Promedio Bogotá 2024' =
			CALCULATE(
			    AVERAGE(Fact_Precios[Precio_COP_kWh]),
			    Fact_Precios[Operador_Regional] = "bogota_cundinamarca",
			    Dim_Calendar[Year] = 2024
			)
		formatString: $#,##0
		displayFolder: 03. Análisis de Precios
		lineageTag: 4dd0c4c4-586a-4651-b786-e13288dc2472

	/// Precio promedio de Antioquia en 2024
	measure 'Precio Promedio Antioquia 2024' =
			CALCULATE(
			    AVERAGE(Fact_Precios[Precio_COP_kWh]),
			    Fact_Precios[Operador_Regional] = "antioquia",
			    Dim_Calendar[Year] = 2024
			)
		formatString: $#,##0
		displayFolder: 03. Análisis de Precios
		lineageTag: 3b67d1d0-50d3-4791-bcb7-d95273feb4a0

	/// Rango de precio en 2024 (max - min)
	measure 'Volatilidad Precio 2024' = CALCULATE([Precio Máximo], Dim_Calendar[Year] = 2024) - CALCULATE([Precio Mínimo], Dim_Calendar[Year] = 2024)
		formatString: $#,##0
		displayFolder: 03. Análisis de Precios
		lineageTag: bdbb352a-3ae9-4abb-8282-052df455e6e5

	measure '% No Regulado' = DIVIDE([Total Demanda No Regulado], [Total Demanda GWh], 0)
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		displayFolder: 01. KPIs Ejecutivos
		lineageTag: 377ac363-5459-47a9-9053-254e67342a2b

	/// ⚡ Tarjeta HTML - Demanda Total con subtítulo
	measure 'HTML Card Demanda Total' = ```
			
			VAR _val = FORMAT(SUM(Fact_Demanda[Demanda_GWh]), "#,##0")
			VAR _nd = FORMAT([Conteo Departamentos], "0")
			VAR _t = [Param Titulo px]
			VAR _v = [Param Valor px]
			VAR _s = [Param Subtitulo px]
			VAR _e = [Param Emoji px]
			VAR _pv = [Param Padding V]
			VAR _ph = [Param Padding H]
			RETURN
			"<style>*{margin:0;padding:0;box-sizing:border-box}.c{font-family:Segoe UI,sans-serif;background:transparent;padding:" & _pv & "px " & _ph & "px}.tp{display:flex;justify-content:space-between;align-items:center;margin-bottom:6px}.lb{font-size:" & _t & "px;color:rgba(255,255,255,.75);font-weight:500;letter-spacing:.3px}.ic{font-size:" & _e & "px;opacity:.7;filter:grayscale(20%)}.vl{font-size:" & _v & "px;font-weight:800;color:#fff;letter-spacing:-.5px;margin:2px 0}.sn{font-size:" & _s & "px;color:rgba(255,255,255,.6);font-weight:700;margin-top:4px}</style><div class='c'><div class='tp'><div class='lb'>Demanda Total</div><div class='ic'>⚡</div></div><div class='vl'>" & _val & " GWh</div><div class='sn'>en 2024 · " & _nd & " departamentos</div></div>"
			
			```
		displayFolder: 05. HTML Cards
		lineageTag: 9ac96ea2-930b-44b5-8dfc-e7754313adad

	/// 🏭 Tarjeta HTML - No Regulado con subtítulo
	measure 'HTML Card No Regulado' = ```
			
			VAR _pct = FORMAT([% No Regulado] * 100, "0.0")
			VAR _gwh = FORMAT([Total Demanda No Regulado], "#,##0")
			VAR _t = [Param Titulo px]
			VAR _v = [Param Valor px]
			VAR _s = [Param Subtitulo px]
			VAR _e = [Param Emoji px]
			VAR _pv = [Param Padding V]
			VAR _ph = [Param Padding H]
			RETURN
			"<style>*{margin:0;padding:0;box-sizing:border-box}.c{font-family:Segoe UI,sans-serif;background:transparent;padding:" & _pv & "px " & _ph & "px}.tp{display:flex;justify-content:space-between;align-items:center;margin-bottom:6px}.lb{font-size:" & _t & "px;color:rgba(255,255,255,.75);font-weight:500;letter-spacing:.3px}.ic{font-size:" & _e & "px;opacity:.7;filter:grayscale(20%)}.vl{font-size:" & _v & "px;font-weight:800;color:#fff;letter-spacing:-.5px;margin:2px 0}.sn{font-size:" & _s & "px;color:rgba(255,255,255,.6);font-weight:700;margin-top:4px}</style><div class='c'><div class='tp'><div class='lb'>No Regulado</div><div class='ic'>🏭</div></div><div class='vl'>" & _pct & "%</div><div class='sn'>" & _gwh & " GWh</div></div>"
			
			```
		displayFolder: 05. HTML Cards
		lineageTag: 7f4b1ac3-e44b-4beb-9d66-697a5af2dea0

	/// 📊 Tarjeta HTML - Regulado con subtítulo
	measure 'HTML Card Regulado' = ```
			
			VAR _pct = FORMAT([% Regulado] * 100, "0.0")
			VAR _gwh = FORMAT([Total Demanda Regulado], "#,##0")
			VAR _t = [Param Titulo px]
			VAR _v = [Param Valor px]
			VAR _s = [Param Subtitulo px]
			VAR _e = [Param Emoji px]
			VAR _pv = [Param Padding V]
			VAR _ph = [Param Padding H]
			RETURN
			"<style>*{margin:0;padding:0;box-sizing:border-box}.c{font-family:Segoe UI,sans-serif;background:transparent;padding:" & _pv & "px " & _ph & "px}.tp{display:flex;justify-content:space-between;align-items:center;margin-bottom:6px}.lb{font-size:" & _t & "px;color:rgba(255,255,255,.75);font-weight:500;letter-spacing:.3px}.ic{font-size:" & _e & "px;opacity:.7;filter:grayscale(20%)}.vl{font-size:" & _v & "px;font-weight:800;color:#fff;letter-spacing:-.5px;margin:2px 0}.sn{font-size:" & _s & "px;color:rgba(255,255,255,.6);font-weight:700;margin-top:4px}</style><div class='c'><div class='tp'><div class='lb'>Regulado</div><div class='ic'>📊</div></div><div class='vl'>" & _pct & "%</div><div class='sn'>" & _gwh & " GWh</div></div>"
			
			```
		displayFolder: 05. HTML Cards
		lineageTag: 8b96958d-6245-4ff9-acfe-11787595664a

	/// 💰 Tarjeta HTML - Bogotá Tarifa con subtítulo
	measure 'HTML Card Bogotá Tarifa' = ```
			
			VAR _precio = FORMAT(CALCULATE(AVERAGE(Fact_Precios[Precio_COP_kWh]), Fact_Precios[Operador_Regional]="BOGOTÁ. D.C."), "#,##0")
			VAR _t = [Param Titulo px]
			VAR _v = [Param Valor px]
			VAR _s = [Param Subtitulo px]
			VAR _e = [Param Emoji px]
			VAR _pv = [Param Padding V]
			VAR _ph = [Param Padding H]
			RETURN
			"<style>*{margin:0;padding:0;box-sizing:border-box}.c{font-family:Segoe UI,sans-serif;background:transparent;padding:" & _pv & "px " & _ph & "px}.tp{display:flex;justify-content:space-between;align-items:center;margin-bottom:6px}.lb{font-size:" & _t & "px;color:rgba(255,255,255,.75);font-weight:500;letter-spacing:.3px}.ic{font-size:" & _e & "px;opacity:.7;filter:grayscale(20%)}.vl{font-size:" & _v & "px;font-weight:800;color:#fff;letter-spacing:-.5px;margin:2px 0}.sn{font-size:" & _s & "px;color:rgba(255,255,255,.6);font-weight:700;margin-top:4px}</style><div class='c'><div class='tp'><div class='lb'>Bogotá Tarifa</div><div class='ic'>💰</div></div><div class='vl'>$" & _precio & "</div><div class='sn'>COP/kWh · OR más caro</div></div>"
			
			```
		displayFolder: 05. HTML Cards
		lineageTag: 087812ee-1b15-4ab6-a33e-ffd03a508afe

	/// 🏆 Tarjeta HTML - Líder Demanda con subtítulo
	measure 'HTML Card Líder Demanda' = ```
			
			VAR _lider = TOPN(1, ALL(Fact_Demanda[Departamento]), CALCULATE(SUM(Fact_Demanda[Demanda_GWh])))
			VAR _lGWh = MAXX(_lider, CALCULATE(SUM(Fact_Demanda[Demanda_GWh])))
			VAR _lPct = DIVIDE(_lGWh, CALCULATE(SUM(Fact_Demanda[Demanda_GWh]), ALL(Fact_Demanda[Departamento])), 0) * 100
			VAR _lNombre = UPPER(MAXX(_lider, Fact_Demanda[Departamento]))
			VAR _t = [Param Titulo px]
			VAR _v = [Param Valor px]
			VAR _s = [Param Subtitulo px]
			VAR _e = [Param Emoji px]
			VAR _pv = [Param Padding V]
			VAR _ph = [Param Padding H]
			RETURN
			"<style>*{margin:0;padding:0;box-sizing:border-box}.c{font-family:Segoe UI,sans-serif;background:transparent;padding:" & _pv & "px " & _ph & "px}.tp{display:flex;justify-content:space-between;align-items:center;margin-bottom:6px}.lb{font-size:" & _t & "px;color:rgba(255,255,255,.75);font-weight:500;letter-spacing:.3px}.ic{font-size:" & _e & "px;opacity:.7;filter:grayscale(20%)}.vl{font-size:" & _v & "px;font-weight:800;color:#fff;letter-spacing:-.5px;margin:2px 0}.sn{font-size:" & _s & "px;color:rgba(255,255,255,.6);font-weight:700;margin-top:4px}</style><div class='c'><div class='tp'><div class='lb'>Líder Demanda</div><div class='ic'>🏆</div></div><div class='vl'>" & _lNombre & "</div><div class='sn'>" & FORMAT(_lGWh, "#,##0") & " GWh · " & FORMAT(_lPct, "0.0") & "%</div></div>"
			
			```
		displayFolder: 05. HTML Cards
		lineageTag: 7bd2bb7f-2897-41dc-9924-aa710d0d430b

