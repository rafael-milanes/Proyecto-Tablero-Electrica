	/// 📊 Barra horizontal de 3 insights ejecutivos - valores fijos 2024. Desactivar interacciones de slicers en el visual.
	measure 'HTML Insights Bar' = ```
			
			VAR _pctNR = FORMAT([% No Regulado] * 100, "0.0")
			VAR _precioBog = FORMAT(
			    CALCULATE(AVERAGE(Fact_Precios[Precio_COP_kWh]), Fact_Precios[Operador_Regional]="BOGOTÁ. D.C.", YEAR(Fact_Precios[Fecha])=2024), "#,##0")
			VAR _precioAnt = FORMAT(
			    CALCULATE(AVERAGE(Fact_Precios[Precio_COP_kWh]), Fact_Precios[Operador_Regional]="ANTIOQUIA", YEAR(Fact_Precios[Fecha])=2024), "#,##0")
			VAR _diffPct = FORMAT(
			    DIVIDE(
			        CALCULATE(AVERAGE(Fact_Precios[Precio_COP_kWh]), Fact_Precios[Operador_Regional]="BOGOTÁ. D.C.", YEAR(Fact_Precios[Fecha])=2024)
			        - CALCULATE(AVERAGE(Fact_Precios[Precio_COP_kWh]), Fact_Precios[Operador_Regional]="ANTIOQUIA", YEAR(Fact_Precios[Fecha])=2024),
			        CALCULATE(AVERAGE(Fact_Precios[Precio_COP_kWh]), Fact_Precios[Operador_Regional]="ANTIOQUIA", YEAR(Fact_Precios[Fecha])=2024), 0
			    ) * 100, "0")
			VAR _top5 = TOPN(5, ALL(Fact_Demanda[Departamento]), CALCULATE(SUM(Fact_Demanda[Demanda_GWh])))
			VAR _top5GWh = SUMX(_top5, CALCULATE(SUM(Fact_Demanda[Demanda_GWh])))
			VAR _top5Pct = FORMAT(DIVIDE(_top5GWh, CALCULATE(SUM(Fact_Demanda[Demanda_GWh]), ALL(Fact_Demanda[Departamento])), 0) * 100, "0.0")
			RETURN
			"<style>*{margin:0;padding:0;box-sizing:border-box}.bar{display:flex;gap:20px;font-family:Segoe UI,sans-serif;background:#0f172a;padding:12px 20px;border-radius:6px}.item{flex:1;padding:10px 14px;border-left:3px solid;border-radius:0 4px 4px 0}.i1{border-color:#3b82f6;background:rgba(59,130,246,.08)}.i2{border-color:#f59e0b;background:rgba(245,158,11,.08)}.i3{border-color:#10b981;background:rgba(16,185,129,.08)}.txt{font-size:12.5px;color:rgba(255,255,255,.85);line-height:1.5}b{color:#fff;font-weight:700}.em{font-size:14px;margin-right:4px}</style><div class='bar'><div class='item i1'><div class='txt'><span class='em'>🏭</span> El mercado <b>No Regulado domina con el " & _pctNR & "%</b> de la demanda total en 2024, indicando un mercado maduro con alta participación de grandes consumidores industriales y comerciales.</div></div><div class='item i2'><div class='txt'><span class='em'>⚠️</span> <b>Bogotá es el OR más costoso ($" & _precioBog & " COP/kWh)</b>, un " & _diffPct & "% más caro que Antioquia ($" & _precioAnt & "), creando oportunidades de arbitraje y migración de clientes.</div></div><div class='item i3'><div class='txt'><span class='em'>✅</span> Los <b>5 departamentos líderes concentran el " & _top5Pct & "%</b> de la demanda total (Antioquia, Valle del Cauca, Meta, Cundinamarca y Bogotá D.C.).</div></div></div>"
			
			```
		displayFolder: 05. HTML Cards
		lineageTag: a49e3f8b-dfeb-43c4-b30b-26f578af9447

	/// 📊 Barra de 3 insights para página Demanda
	measure 'HTML Insights Demanda' = ```
			
			VAR _avgLV = CALCULATE(AVERAGE(Fact_Demanda[Demanda_GWh]), Dim_Calendar[Day Number] <= 5)
			VAR _avgDom = CALCULATE(AVERAGE(Fact_Demanda[Demanda_GWh]), Dim_Calendar[Day Number] = 7)
			VAR _caida = FORMAT(DIVIDE(_avgLV - _avgDom, _avgLV, 0) * 100, "0")
			VAR _metaPct = FORMAT(CALCULATE(DIVIDE(CALCULATE(SUM(Fact_Demanda[Demanda_GWh]), Fact_Demanda[Tipo_Mercado]="No Regulado"), SUM(Fact_Demanda[Demanda_GWh]),0) * 100, Fact_Demanda[Departamento]="META"), "0.0")
			VAR _araucaPct = FORMAT(CALCULATE(DIVIDE(CALCULATE(SUM(Fact_Demanda[Demanda_GWh]), Fact_Demanda[Tipo_Mercado]="No Regulado"), SUM(Fact_Demanda[Demanda_GWh]),0) * 100, Fact_Demanda[Departamento]="ARAUCA"), "0.0")
			RETURN
			"<style>*{margin:0;padding:0;box-sizing:border-box}.bar{display:flex;gap:20px;font-family:Segoe UI,sans-serif;background:#0f172a;padding:12px 20px;border-radius:6px}.item{flex:1;padding:10px 14px;border-left:3px solid;border-radius:0 4px 4px 0}.i1{border-color:#3b82f6;background:rgba(59,130,246,.08)}.i2{border-color:#f59e0b;background:rgba(245,158,11,.08)}.i3{border-color:#10b981;background:rgba(16,185,129,.08)}.txt{font-size:12.5px;color:rgba(255,255,255,.85);line-height:1.5}b{color:#fff;font-weight:700}.em{font-size:14px;margin-right:4px}</style><div class='bar'><div class='item i1'><div class='txt'><span class='em'>✅</span> <b>Estacionalidad estable:</b> Picos de demanda en Mar y Oct. Junio registra la demanda más baja del año, coincidiendo con menor actividad industrial.</div></div><div class='item i2'><div class='txt'><span class='em'>⚠️</span> <b>Patrón semanal marcado:</b> El consumo cae ~" & _caida & "% los domingos vs. días hábiles, confirmando la dominancia del consumo industrial y comercial en la matriz energética.</div></div><div class='item i3'><div class='txt'><span class='em'>🏭</span> <b>Meta (" & _metaPct & "%) y Arauca (" & _araucaPct & "% No Regulado)</b> sugieren alta concentración en grandes consumidores industriales, posiblemente vinculados al sector petrolero y extractivo.</div></div></div>"
			
			```
		displayFolder: 05. HTML Cards
		lineageTag: 67dfaa91-90b3-49c9-9cfc-93459f4e1877

	measure 'Precio Promedio PY' = CALCULATE([Precio Promedio], SAMEPERIODLASTYEAR(Dim_Calendar[Date]))
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: 03. Análisis de Precios
		lineageTag: 716332bb-4012-4643-9bf4-1fe27edd5427

	/// 🎯 Mercados Prioritarios + Recomendaciones Clave (2 columnas)
	measure 'HTML Estrategia Top' = ```
			
			VAR _pctNR = FORMAT([% No Regulado] * 100, "0.0")
			VAR _diffPct = FORMAT(
			    DIVIDE(
			        CALCULATE(AVERAGE(Fact_Precios[Precio_COP_kWh]), Fact_Precios[Operador_Regional]="BOGOTÁ. D.C.", YEAR(Fact_Precios[Fecha])=2024)
			        - CALCULATE(AVERAGE(Fact_Precios[Precio_COP_kWh]), Fact_Precios[Operador_Regional]="ANTIOQUIA", YEAR(Fact_Precios[Fecha])=2024),
			        CALCULATE(AVERAGE(Fact_Precios[Precio_COP_kWh]), Fact_Precios[Operador_Regional]="ANTIOQUIA", YEAR(Fact_Precios[Fecha])=2024), 0
			    ) * 100, "0")
			VAR _bogMin = FORMAT(CALCULATE(MIN(Fact_Precios[Precio_COP_kWh]), Fact_Precios[Operador_Regional]="BOGOTÁ. D.C.", YEAR(Fact_Precios[Fecha])=2024), "#,##0")
			VAR _bogMax = FORMAT(CALCULATE(MAX(Fact_Precios[Precio_COP_kWh]), Fact_Precios[Operador_Regional]="BOGOTÁ. D.C.", YEAR(Fact_Precios[Fecha])=2024), "#,##0")
			RETURN
			"<style>*{margin:0;padding:0;box-sizing:border-box}.row{display:flex;gap:20px;font-family:Segoe UI,sans-serif}.col{flex:1;background:#0f172a;border-radius:6px;padding:16px 20px}.hd{font-size:15px;font-weight:700;color:#fff;margin-bottom:12px}.em{margin-right:5px}.tier{font-size:13px;font-weight:700;color:#60a5fa;margin:10px 0 6px}.li{font-size:12px;color:rgba(255,255,255,.8);line-height:1.7;padding-left:8px}.rec{display:flex;align-items:flex-start;gap:10px;margin-bottom:10px}.num{min-width:22px;height:22px;border-radius:50%;background:#1e40af;color:#fff;font-size:11px;font-weight:700;display:flex;align-items:center;justify-content:center;flex-shrink:0}.rtx{font-size:12px;color:rgba(255,255,255,.8);line-height:1.5}</style><div class='row'><div class='col'><div class='hd'><span class='em'>🎯</span> Mercados Prioritarios</div><div class='tier'>Tier 1 — Alta demanda + Alto NR:</div><div class='li'>• Antioquia (3.436 GWh, 91,5% NR)</div><div class='li'>• Valle del Cauca (3.393 GWh, 82,5% NR)</div><div class='li'>• Meta (2.947 GWh, 98,6% NR)</div><div class='li'>• Cundinamarca (2.867 GWh, 88,9% NR)</div><div class='tier'>Tier 2 — Oportunidad de crecimiento:</div><div class='li'>• Bogotá D.C. (2.715 GWh, 78,3% NR)</div><div class='li'>• Atlántico (1.771 GWh, 84,2% NR)</div></div><div class='col'><div class='hd'><span class='em'>📋</span> Recomendaciones Clave</div><div class='rec'><div class='num'>1</div><div class='rtx'>Aprovechar diferencial Bogotá vs Antioquia (" & _diffPct & "% más caro) para campañas de migración de clientes No Regulados.</div></div><div class='rec'><div class='num'>2</div><div class='rtx'>Enfocar esfuerzo comercial en segmento No Regulado (" & _pctNR & "%) donde hay libertad de elección de proveedor.</div></div><div class='rec'><div class='num'>3</div><div class='rtx'>Monitorear volatilidad Costa Caribe (Bolívar, Atlántico) como señal de riesgo y oportunidad.</div></div><div class='rec'><div class='num'>4</div><div class='rtx'>Explorar mercados de alta concentración industrial (Meta, Arauca — sector petrolero).</div></div><div class='rec'><div class='num'>5</div><div class='rtx'>Diseñar ofertas con precios estabilizados para captar clientes afectados por la alta volatilidad de Bogotá ($" & _bogMin & "–$" & _bogMax & ").</div></div></div></div>"
			
			```
		displayFolder: 05. HTML Cards
		lineageTag: cd858422-7967-4c95-b2f0-49b1711417da

	/// 💡 3 insights finales de estrategia (horizontal)
	measure 'HTML Estrategia Bottom' = ```
			
			VAR _bogPctNR = FORMAT(CALCULATE(DIVIDE(CALCULATE(SUM(Fact_Demanda[Demanda_GWh]), Fact_Demanda[Tipo_Mercado]="No Regulado"), SUM(Fact_Demanda[Demanda_GWh]),0)*100, Fact_Demanda[Departamento]="BOGOTÁ. D.C."), "0.0")
			VAR _bogRegGWh = FORMAT(CALCULATE(SUM(Fact_Demanda[Demanda_GWh]), Fact_Demanda[Departamento]="BOGOTÁ. D.C.", Fact_Demanda[Tipo_Mercado]="Regulado"), "#,##0")
			VAR _antPrecio = FORMAT(CALCULATE(AVERAGE(Fact_Precios[Precio_COP_kWh]), Fact_Precios[Operador_Regional]="ANTIOQUIA", YEAR(Fact_Precios[Fecha])=2024), "#,##0")
			RETURN
			"<style>*{margin:0;padding:0;box-sizing:border-box}.bar{display:flex;gap:20px;font-family:Segoe UI,sans-serif;background:transparent;padding:0}.item{flex:1;padding:10px 14px;border-left:3px solid;border-radius:0 4px 4px 0;background:#0f172a}.i1{border-color:#3b82f6}.i2{border-color:#10b981}.i3{border-color:#f59e0b}.txt{font-size:12px;color:rgba(255,255,255,.85);line-height:1.5}b{color:#fff;font-weight:700}.em{font-size:13px;margin-right:4px}</style><div class='bar'><div class='item i1'><div class='txt'><span class='em'>💡</span> <b>Oportunidad clave en Bogotá:</b> Con " & _bogPctNR & "% NR (el más bajo entre grandes dptos), ~" & _bogRegGWh & " GWh de mercado Regulado son potencialmente migrables. EnergyConsult puede competir contra el OR más caro del país con contratos atractivos de largo plazo.</div></div><div class='item i2'><div class='txt'><span class='em'>🎯</span> <b>Estrategia de precio:</b> Con Antioquia como benchmark ($" & _antPrecio & "), hay espacio significativo para ofrecer tarifas competitivas donde los ORs cobran >$400 (Bogotá, Bolívar, Cali), capturando grandes consumidores.</div></div><div class='item i3'><div class='txt'><span class='em'>⚠️</span> <b>Gestión de riesgo:</b> La tendencia alcista de precios 2023–2024 podría continuar por efectos climáticos (El Niño) y costos de generación. Una estrategia de cobertura de precios sería un diferenciador clave.</div></div></div>"
			
			```
		displayFolder: 05. HTML Cards
		lineageTag: f81f8933-15e4-4f40-a874-4ebe7b3cc821

	/// 📊 3 insights para página Precios
	measure 'HTML Insights Precios' = ```
			
			VAR _bolJun = FORMAT(CALCULATE(AVERAGE(Fact_Precios[Precio_COP_kWh]), Fact_Precios[Operador_Regional]="BOLÍVAR", YEAR(Fact_Precios[Fecha])=2023, MONTH(Fact_Precios[Fecha])=6), "#,##0")
			VAR _atlJun = FORMAT(CALCULATE(AVERAGE(Fact_Precios[Precio_COP_kWh]), Fact_Precios[Operador_Regional]="ATLÁNTICO", YEAR(Fact_Precios[Fecha])=2023, MONTH(Fact_Precios[Fecha])=6), "#,##0")
			VAR _bogIni = FORMAT(CALCULATE(AVERAGE(Fact_Precios[Precio_COP_kWh]), Fact_Precios[Operador_Regional]="BOGOTÁ. D.C.", YEAR(Fact_Precios[Fecha])=2022, MONTH(Fact_Precios[Fecha])=8), "#,##0")
			VAR _bogProm = FORMAT(CALCULATE(AVERAGE(Fact_Precios[Precio_COP_kWh]), Fact_Precios[Operador_Regional]="BOGOTÁ. D.C.", YEAR(Fact_Precios[Fecha])=2024), "#,##0")
			VAR _bogIncr = FORMAT(DIVIDE(CALCULATE(AVERAGE(Fact_Precios[Precio_COP_kWh]), Fact_Precios[Operador_Regional]="BOGOTÁ. D.C.", YEAR(Fact_Precios[Fecha])=2024) - CALCULATE(AVERAGE(Fact_Precios[Precio_COP_kWh]), Fact_Precios[Operador_Regional]="BOGOTÁ. D.C.", YEAR(Fact_Precios[Fecha])=2022, MONTH(Fact_Precios[Fecha])=8), CALCULATE(AVERAGE(Fact_Precios[Precio_COP_kWh]), Fact_Precios[Operador_Regional]="BOGOTÁ. D.C.", YEAR(Fact_Precios[Fecha])=2022, MONTH(Fact_Precios[Fecha])=8), 0) * 100, "0")
			VAR _antProm = FORMAT(CALCULATE(AVERAGE(Fact_Precios[Precio_COP_kWh]), Fact_Precios[Operador_Regional]="ANTIOQUIA", YEAR(Fact_Precios[Fecha])=2024), "#,##0")
			RETURN
			"<style>*{margin:0;padding:0;box-sizing:border-box}.bar{display:flex;gap:22px;font-family:Segoe UI,sans-serif;padding:10px 0}.item{flex:1;padding:18px 22px;border-left:4px solid;border-radius:0 5px 5px 0;background:rgba(15,23,42,.85)}.i1{border-color:#ef4444}.i2{border-color:#3b82f6}.i3{border-color:#10b981}.txt{font-size:17px;color:rgba(255,255,255,.85);line-height:1.65}b{color:#fff;font-weight:700}.em{font-size:19px;margin-right:5px}</style><div class='bar'><div class='item i1'><div class='txt'><span class='em'>🟠</span> <b>Pico jun-2023:</b> Bolívar ($" & _bolJun & ") y Atlántico ($" & _atlJun & ") — crisis de suministro Costa Caribe por El Niño.</div></div><div class='item i2'><div class='txt'><span class='em'>📈</span> <b>Tendencia alcista:</b> Bogotá pasó de ~$" & _bogIni & " (ago-2022) a ~$" & _bogProm & " en 2024, +" & _bogIncr & "% de incremento.</div></div><div class='item i3'><div class='txt'><span class='em'>✅</span> <b>Antioquia la más competitiva</b> ($" & _antProm & " COP/kWh promedio 2024) — posición ideal para atraer grandes consumidores.</div></div></div>"
			
			```
		displayFolder: 05. HTML Cards
		lineageTag: 9c424af5-030d-4018-9a83-fb5709616b28

	/// 📊 Volatilidad Min-Max con linear-gradient (compatible HTML Content)
	measure 'HTML Volatilidad Precios' = ```
			
			VAR _gMin = 280 VAR _gMax = 490 VAR _rng = _gMax - _gMin
			VAR _b1Min = CALCULATE(MIN(Fact_Precios[Precio_COP_kWh]), Fact_Precios[Operador_Regional]="BOGOTÁ. D.C.", YEAR(Fact_Precios[Fecha])=2024)
			VAR _b1Max = CALCULATE(MAX(Fact_Precios[Precio_COP_kWh]), Fact_Precios[Operador_Regional]="BOGOTÁ. D.C.", YEAR(Fact_Precios[Fecha])=2024)
			VAR _b1Avg = CALCULATE(AVERAGE(Fact_Precios[Precio_COP_kWh]), Fact_Precios[Operador_Regional]="BOGOTÁ. D.C.", YEAR(Fact_Precios[Fecha])=2024)
			VAR _b2Min = CALCULATE(MIN(Fact_Precios[Precio_COP_kWh]), Fact_Precios[Operador_Regional]="BOLÍVAR", YEAR(Fact_Precios[Fecha])=2024)
			VAR _b2Max = CALCULATE(MAX(Fact_Precios[Precio_COP_kWh]), Fact_Precios[Operador_Regional]="BOLÍVAR", YEAR(Fact_Precios[Fecha])=2024)
			VAR _b2Avg = CALCULATE(AVERAGE(Fact_Precios[Precio_COP_kWh]), Fact_Precios[Operador_Regional]="BOLÍVAR", YEAR(Fact_Precios[Fecha])=2024)
			VAR _b3Min = CALCULATE(MIN(Fact_Precios[Precio_COP_kWh]), Fact_Precios[Operador_Regional]="VALLE DEL CAUCA", YEAR(Fact_Precios[Fecha])=2024)
			VAR _b3Max = CALCULATE(MAX(Fact_Precios[Precio_COP_kWh]), Fact_Precios[Operador_Regional]="VALLE DEL CAUCA", YEAR(Fact_Precios[Fecha])=2024)
			VAR _b3Avg = CALCULATE(AVERAGE(Fact_Precios[Precio_COP_kWh]), Fact_Precios[Operador_Regional]="VALLE DEL CAUCA", YEAR(Fact_Precios[Fecha])=2024)
			VAR _b4Min = CALCULATE(MIN(Fact_Precios[Precio_COP_kWh]), Fact_Precios[Operador_Regional]="ATLÁNTICO", YEAR(Fact_Precios[Fecha])=2024)
			VAR _b4Max = CALCULATE(MAX(Fact_Precios[Precio_COP_kWh]), Fact_Precios[Operador_Regional]="ATLÁNTICO", YEAR(Fact_Precios[Fecha])=2024)
			VAR _b4Avg = CALCULATE(AVERAGE(Fact_Precios[Precio_COP_kWh]), Fact_Precios[Operador_Regional]="ATLÁNTICO", YEAR(Fact_Precios[Fecha])=2024)
			VAR _b5Min = CALCULATE(MIN(Fact_Precios[Precio_COP_kWh]), Fact_Precios[Operador_Regional]="ANTIOQUIA", YEAR(Fact_Precios[Fecha])=2024)
			VAR _b5Max = CALCULATE(MAX(Fact_Precios[Precio_COP_kWh]), Fact_Precios[Operador_Regional]="ANTIOQUIA", YEAR(Fact_Precios[Fecha])=2024)
			VAR _b5Avg = CALCULATE(AVERAGE(Fact_Precios[Precio_COP_kWh]), Fact_Precios[Operador_Regional]="ANTIOQUIA", YEAR(Fact_Precios[Fecha])=2024)
			VAR _fn = "<table style='width:100%;border-collapse:collapse;font-family:Segoe UI,sans-serif'><tr><td colspan='3' style='padding:10px 0 16px;font-size:16px;font-weight:700;color:#fff'>Volatilidad de Precios 2024 (Min–Max)</td></tr>"
			VAR _mkBar = 
			    "<tr><td style='width:110px;font-size:14px;font-weight:700;color:#ef6461;padding:8px 0'>BOGOTÁ. D.C.</td>" &
			    "<td style='padding:8px 12px'><div style='width:100%;height:12px;border-radius:6px;background:linear-gradient(to right,#1e293b " & FORMAT(DIVIDE(_b1Min-_gMin,_rng,0)*100,"0") & "%,#ef6461 " & FORMAT(DIVIDE(_b1Min-_gMin,_rng,0)*100,"0") & "%,#ef6461 " & FORMAT(DIVIDE(_b1Max-_gMin,_rng,0)*100,"0") & "%,#1e293b " & FORMAT(DIVIDE(_b1Max-_gMin,_rng,0)*100,"0") & "%)'></div></td>" &
			    "<td style='width:120px;font-size:13px;color:rgba(255,255,255,.6);text-align:right;padding:8px 0'>$" & FORMAT(_b1Min,"#,##0") & " — $" & FORMAT(_b1Max,"#,##0") & "</td></tr>"
			VAR _mkBar2 = 
			    "<tr><td style='width:110px;font-size:14px;font-weight:700;color:#a78bfa;padding:8px 0'>BOLÍVAR</td>" &
			    "<td style='padding:8px 12px'><div style='width:100%;height:12px;border-radius:6px;background:linear-gradient(to right,#1e293b " & FORMAT(DIVIDE(_b2Min-_gMin,_rng,0)*100,"0") & "%,#a78bfa " & FORMAT(DIVIDE(_b2Min-_gMin,_rng,0)*100,"0") & "%,#a78bfa " & FORMAT(DIVIDE(_b2Max-_gMin,_rng,0)*100,"0") & "%,#1e293b " & FORMAT(DIVIDE(_b2Max-_gMin,_rng,0)*100,"0") & "%)'></div></td>" &
			    "<td style='width:120px;font-size:13px;color:rgba(255,255,255,.6);text-align:right;padding:8px 0'>$" & FORMAT(_b2Min,"#,##0") & " — $" & FORMAT(_b2Max,"#,##0") & "</td></tr>"
			VAR _mkBar3 = 
			    "<tr><td style='width:110px;font-size:14px;font-weight:700;color:#fb923c;padding:8px 0'>VALLE DEL CAUCA</td>" &
			    "<td style='padding:8px 12px'><div style='width:100%;height:12px;border-radius:6px;background:linear-gradient(to right,#1e293b " & FORMAT(DIVIDE(_b3Min-_gMin,_rng,0)*100,"0") & "%,#fb923c " & FORMAT(DIVIDE(_b3Min-_gMin,_rng,0)*100,"0") & "%,#fb923c " & FORMAT(DIVIDE(_b3Max-_gMin,_rng,0)*100,"0") & "%,#1e293b " & FORMAT(DIVIDE(_b3Max-_gMin,_rng,0)*100,"0") & "%)'></div></td>" &
			    "<td style='width:120px;font-size:13px;color:rgba(255,255,255,.6);text-align:right;padding:8px 0'>$" & FORMAT(_b3Min,"#,##0") & " — $" & FORMAT(_b3Max,"#,##0") & "</td></tr>"
			VAR _mkBar4 = 
			    "<tr><td style='width:110px;font-size:14px;font-weight:700;color:#60a5fa;padding:8px 0'>ATLÁNTICO</td>" &
			    "<td style='padding:8px 12px'><div style='width:100%;height:12px;border-radius:6px;background:linear-gradient(to right,#1e293b " & FORMAT(DIVIDE(_b4Min-_gMin,_rng,0)*100,"0") & "%,#60a5fa " & FORMAT(DIVIDE(_b4Min-_gMin,_rng,0)*100,"0") & "%,#60a5fa " & FORMAT(DIVIDE(_b4Max-_gMin,_rng,0)*100,"0") & "%,#1e293b " & FORMAT(DIVIDE(_b4Max-_gMin,_rng,0)*100,"0") & "%)'></div></td>" &
			    "<td style='width:120px;font-size:13px;color:rgba(255,255,255,.6);text-align:right;padding:8px 0'>$" & FORMAT(_b4Min,"#,##0") & " — $" & FORMAT(_b4Max,"#,##0") & "</td></tr>"
			VAR _mkBar5 = 
			    "<tr><td style='width:110px;font-size:14px;font-weight:700;color:#5eead4;padding:8px 0'>ANTIOQUIA</td>" &
			    "<td style='padding:8px 12px'><div style='width:100%;height:12px;border-radius:6px;background:linear-gradient(to right,#1e293b " & FORMAT(DIVIDE(_b5Min-_gMin,_rng,0)*100,"0") & "%,#5eead4 " & FORMAT(DIVIDE(_b5Min-_gMin,_rng,0)*100,"0") & "%,#5eead4 " & FORMAT(DIVIDE(_b5Max-_gMin,_rng,0)*100,"0") & "%,#1e293b " & FORMAT(DIVIDE(_b5Max-_gMin,_rng,0)*100,"0") & "%)'></div></td>" &
			    "<td style='width:120px;font-size:13px;color:rgba(255,255,255,.6);text-align:right;padding:8px 0'>$" & FORMAT(_b5Min,"#,##0") & " — $" & FORMAT(_b5Max,"#,##0") & "</td></tr>"
			RETURN _fn & _mkBar & _mkBar2 & _mkBar3 & _mkBar4 & _mkBar5 & "</table>"
			
			```
